  "bugs": {
    "url": "https://github.com/quyvan0320/az-fashion-ecommerce/issues"
  },
  "homepage": "https://github.com/quyvan0320/az-fashion-ecommerce#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "react-helmet-async": "^3.0.0",
    "react-quill": "^2.0.0",
    "swiper": "^12.1.3",
    "zustand": "^5.0.12"
  }
}
